C4Container
    title Diagrama de Containers (C4 Nível 2) - Sistema FabLab

    Person(academico, "Usuário Acadêmico", "Solicitante: consulta disponibilidade, reserva máquinas, consulta fila e registra consumo")
    Person(industrial, "Usuário de Projeto Industrial", "Solicitante: reserva máquinas para projetos industriais")
    Person(admin, "Administrador / Técnico", "Aprova ou nega reservas, gerencia máquinas, fila, estoque e compras")

    System_Ext(login, "Sistema de Login", "Autenticação e perfis de acesso (RF24)")
    System_Ext(financeiro, "Sistema Financeiro", "Aprova ou recusa solicitações de compra (RF19, RF20)")
    System_Ext(fornecedor, "Portal do Fornecedor", "Recebe pedidos aprovados e confirma entrega (RF21, RF22)")
    System_Ext(notificacao, "Serviço de Notificação", "Envia e-mails/mensagens sobre reservas e compras (RF25)")

    System_Boundary(fablab, "Sistema FabLab") {
        Container(web, "Aplicação Web", "SPA (ex.: React)", "Interface para solicitantes e administradores/técnicos")
        Container(api, "API Backend", "REST (ex.: Node.js / Spring Boot)", "Expõe as funcionalidades e aplica as regras de negócio")

        Container(reservas, "Módulo de Reservas", "Componente do backend", "Disponibilidade, reservas, conflitos, fila de prioridade, aprovação/negação com justificativa")
        Container(maquinas, "Módulo de Máquinas", "Componente do backend", "Cadastro, estado da máquina e controle de manutenção")
        Container(insumos, "Módulo de Insumos e Compras", "Componente do backend", "Registro de consumo, estoque, solicitação de compra e recebimento")
        Container(acesso, "Módulo de Controle de Acesso", "Componente do backend", "Valida perfil e permissões do usuário")
        Container(eventos, "Módulo de Eventos e Notificações", "Componente do backend", "Publica eventos de reservas e compras para notificação")

        ContainerDb(db, "Banco de Dados", "PostgreSQL", "Máquinas, reservas, fila, manutenções, insumos, consumo, estoque, compras e usuários")
    }

    Rel(academico, web, "Usa", "HTTPS")
    Rel(industrial, web, "Usa", "HTTPS")
    Rel(admin, web, "Usa", "HTTPS")

    Rel(web, api, "Faz requisições", "JSON/HTTPS")

    Rel(api, acesso, "Valida perfil e permissões")
    Rel(api, reservas, "Delega operações de reserva")
    Rel(api, maquinas, "Delega gestão de máquinas")
    Rel(api, insumos, "Delega estoque e compras")

    Rel(reservas, maquinas, "Consulta estado/manutenção da máquina")
    Rel(insumos, maquinas, "Associa consumo à máquina utilizada")
    Rel(reservas, eventos, "Publica eventos (aprovação, negação, fila)")
    Rel(insumos, eventos, "Publica eventos (compra, entrega)")

    Rel(reservas, db, "Lê e grava", "SQL")
    Rel(maquinas, db, "Lê e grava", "SQL")
    Rel(insumos, db, "Lê e grava", "SQL")
    Rel(acesso, db, "Lê perfis", "SQL")

    Rel(acesso, login, "Autentica usuários", "OAuth2/OIDC")
    Rel(insumos, financeiro, "Envia solicitação de compra e recebe aprovação/recusa", "API/HTTPS")
    Rel(insumos, fornecedor, "Envia pedido aprovado e recebe confirmação de entrega", "API/HTTPS")
    Rel(eventos, notificacao, "Solicita envio de notificações", "API/HTTPS")
    Rel(notificacao, academico, "Notifica")
    Rel(notificacao, admin, "Notifica")