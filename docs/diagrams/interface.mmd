flowchart TB
    classDef interface fill:#fff8dc,stroke:#8a6d00;
    classDef servico fill:#e8f0fe,stroke:#1a4fa0;
    classDef entidade fill:#e6f4ea,stroke:#1e6b34;

    subgraph R1["Camada 1 — Entidades"]
        RES["Reserva<br/>+id<br/>+periodo<br/>+status<br/>+justificativa"]
        MAQ["Maquina<br/>+id<br/>+tipo<br/>+estado"]
    end

    subgraph R2["Camada 2 — Serviços (implementações)"]
        LOGIN["LoginService"]
        MAQS["MaquinaService"]
        RESS["ReservaService"]
        FILAS["FilaPrioridadeService"]
        NOTS["NotificacaoService"]
        ESTS["EstoqueService"]
    end

    subgraph R3["Camada 3 — Interfaces"]
        IAUT["«interface»<br/>IAutenticacao<br/>+autenticar(credenciais) Perfil<br/>+verificarPermissao(perfil, funcionalidade) boolean"]
        IMAQ["«interface»<br/>IMaquinaService<br/>+consultarDisponibilidade(periodo) Horario[]<br/>+obterEstado(maquinaId) EstadoMaquina<br/>+cadastrar(maquina) void<br/>+atualizar(maquina) void<br/>+marcarManutencao(maquinaId, periodo) void"]
        IRES["«interface»<br/>IReservaService<br/>+solicitar(maquinaId, periodo) Reserva<br/>+aprovar(reservaId) void<br/>+negar(reservaId, justificativa) void<br/>+cancelar(reservaId) void"]
        IFILA["«interface»<br/>IFilaPrioridade<br/>+identificarConflito(maquinaId, periodo) boolean<br/>+enfileirar(reservaId) int<br/>+consultarPosicao(reservaId) int<br/>+reordenar(maquinaId, novaOrdem) void"]
        INOT["«interface»<br/>INotificacao<br/>+notificar(destinatario, evento) void"]
        IEST["«interface»<br/>IEstoqueService<br/>+registrarConsumo(insumoId, quantidade) void<br/>+consultarEstoque() Insumo[]<br/>+solicitarCompra(insumoId, quantidade) PedidoCompra"]
    end

    LOGIN -.->|implementa| IAUT
    MAQS -.->|implementa| IMAQ
    RESS -.->|implementa| IRES
    FILAS -.->|implementa| IFILA
    NOTS -.->|implementa| INOT
    ESTS -.->|implementa| IEST

    RESS -->|"verifica estado"| IMAQ
    RESS -->|"trata conflitos"| IFILA
    RESS -->|"dispara eventos"| INOT
    RESS -->|"valida perfil"| IAUT
    ESTS -->|"dispara eventos"| INOT

    RESS ==>|"gerencia 1..*"| RES
    MAQS ==>|"gerencia 1..*"| MAQ
    RES ==>|"reserva *..1"| MAQ

    class IAUT,IMAQ,IRES,IFILA,INOT,IEST interface
    class LOGIN,MAQS,RESS,FILAS,NOTS,ESTS servico
    class RES,MAQ entidade